APP_NAME=TaskForge
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
INTERNAL_API_KEY=change-me-internal-key

DATABASE_URL=mysql+pymysql://taskforge:taskforge@localhost:3306/taskforge
REDIS_URL=redis://127.0.0.1:6380/0
RQ_QUEUE_NAME=taskforge

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@taskforge.local
SMTP_TLS=true

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080"]
LOG_LEVEL=INFO
JSON_LOGS=true

# Grafana Cloud (optional): push metrics + logs without installing anything.
# From grafana.com -> your stack -> Prometheus "Details" and Loki "Details".
# METRICS_URL = the Prometheus remote-write host, with path /api/v1/push/influx/write
# LOGS_URL    = the Loki host, with path /loki/api/v1/push
GRAFANA_CLOUD_METRICS_URL=
GRAFANA_CLOUD_METRICS_USER=
GRAFANA_CLOUD_LOGS_URL=
GRAFANA_CLOUD_LOGS_USER=
# Cloud Access Policy token with scopes metrics:write and logs:write. Keep it only in .env.
GRAFANA_CLOUD_TOKEN=
