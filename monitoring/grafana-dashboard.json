        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "(sum(rate(http_requests_total{job=\"taskforge\", env=~\"$env\", status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_requests_total{job=\"taskforge\", env=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "",
          "refId": "A",
          "instant": false
        }
      ],
      "options": {
