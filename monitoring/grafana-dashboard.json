      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(http_requests_total{job=\"taskforge\", env=~\"$env\", handler!=\"/metrics\"}[$__rate_interval]))",
